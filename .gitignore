# Unreal-generated, machine-local, or rebuildable output
Binaries/
Build/
Intermediate/
Saved/
DerivedDataCache/
.vs/
*.sln
*.VC.db
*.opensdf
*.suo

# Microsoft Build Tools bootstrapper: its license forbids redistribution.
# Scripts/install-build-tools.ps1 pins its SHA-256; obtain it from Microsoft.
Prerequisites/

# Local packaging output (reproduce with Scripts/package_checkpoint.py)
*.zip

# Bulky or machine-specific run output. Durable evidence (*.json, review PNGs)
# stays tracked; frames, logs and video are regenerated by StreetVerify/StreetRecord.
Evidence/walkthrough-frames/
Evidence/packaged/*.log
Evidence/*.log
Evidence/*.mp4

__pycache__/
